{
    "version": 4,
    "configurations": [
        {
            "name": "ESP32-S3 (PlatformIO)",
            "includePath": [
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/src/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
                "${env:HOME}/.platformio/packages/tool-cppcheck/cppcheck-2.15/include/**",
                "/usr/include/**",
                "/usr/local/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "BOARD_HAS_PSRAM=1",
                "CONFIG_IDF_TARGET_ESP32S3",
                "ESP32",
                "ARDUINO=10805",
                "ARDUINO_ESP32_DEV",
                "F_CPU=240000000L",
                "HAVE_CONFIG_H",
                "TFT_eSPI",
                "LVGL_CONF_INCLUDE_SIMPLE"
            ],
            "compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensaesp32s3/bin/xtensa-esp32s3-elf-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64",
            "compilerArgs": [
                "-mcpu=xtensa-esp32s3",
                "-mfix-esp32-psram-cache-issue",
                "-march=esp32s3"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${env:HOME}/.platformio/packages/framework-arduinoespressif32",
                    "${env:HOME}/.platformio/packages/toolchain-xtensaesp32s3"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/.c_cpp_database"
            }
        }
    ]
}
