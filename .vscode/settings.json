{
    // ============ PlatformIO Extension ============
    "platformio-ide.activateOnStartup": true,
    "platformio-ide.autoPreloadPlatforms": true,
    "platformio-ide.useBuiltinPIOCore": true,

    // ============ C/C++ IntelliSense ============
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.intelliSenseEngineFallback": "enabled",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocomplete": "enabled",
    "C_Cpp.formatting": "enabled",
    "C_Cpp.hover": "enabled",
    "C_Cpp.codeAnalysis.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.enabled": false,

    // ============ Editor Einstellungen ============
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[platformio-ini]": {
        "editor.defaultFormatter": "platformio.platformio-ide"
    },

    // ============ C++ Formatting (clang-format) ============
    "C_Cpp.clang_format_style": "{BasedOnStyle: LLVM, IndentWidth: 4, UseTab: Never, ColumnLimit: 100}",

    // ============ Dateien Assoziation ============
    "files.associations": {
        "*.pio": "ini",
        "*.cpp": "cpp",
        "*.h": "c",
        "lv_conf.h": "c",
        "User_Setup.h": "c"
    },

    // ============ Git Einstellungen ============
    "git.ignoreLimitWarning": true,
    "git.autofetch": true,

    // ============ Terminal Einstellungen ============
    "terminal.integrated.env.linux": {
        "PATH": "${env:PATH}"
    },
    "terminal.integrated.defaultProfile.linux": "bash",

    // ============ Datei Ausschlüsse ============
    "files.exclude": {
        "**/.git": true,
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true,
        "**/build": true,
        "**/__pycache__": true
    },

    // ============ Search Ausschlüsse ============
    "search.exclude": {
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true,
        "**/build": true
    },

    // ============ Code Folding ============
    "editor.foldingStrategy": "indentation",
    "[cpp]": {
        "editor.suggest.insertMode": "replace"
    },

    // ============ Debugging ============
    "debug.openDebug": "neverOpen",
    "debug.showDebugOutput": true,

    // ============ Telemetry (Optional) ============
    "telemetry.telemetryLevel": "off",

    // ============ Theme & Appearance ============
    "editor.wordWrap": "on",
    "editor.minimap.enabled": true,
    "editor.rulers": [80, 100, 120],
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
}
