{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlatformIO: Build",
            "type": "shell",
            "command": "platformio",
            "args": ["run"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "file": "$1",
                    "location": "$2:$3",
                    "message": "$4"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "PlatformIO: Upload",
            "type": "shell",
            "command": "platformio",
            "args": ["run", "-t", "upload"],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": ["PlatformIO: Build"]
        },
        {
            "label": "PlatformIO: Monitor",
            "type": "shell",
            "command": "platformio",
            "args": ["device", "monitor", "-b", "115200"],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 0,
                    "location": 0,
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Listening on.*",
                    "endsPattern": "^.*$"
                }
            }
        },
        {
            "label": "PlatformIO: Upload and Monitor",
            "type": "shell",
            "command": "platformio",
            "args": ["run", "-t", "upload", "--", "-b", "115200"],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": ["PlatformIO: Build"]
        },
        {
            "label": "PlatformIO: Clean",
            "type": "shell",
            "command": "platformio",
            "args": ["run", "-t", "clean"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "PlatformIO: Full Clean",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", ".pio", "build", ".platformio"],
            "windows": {
                "command": "powershell",
                "args": ["-Command", "Remove-Item -Recurse -Force .pio, build, .platformio"]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "PlatformIO: Scan WiFi",
            "type": "shell",
            "command": "echo 'Type: scan' | platformio device monitor -b 115200",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Git: Commit & Push",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "git add -A && git commit -m 'VSCode integration' && git push"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
