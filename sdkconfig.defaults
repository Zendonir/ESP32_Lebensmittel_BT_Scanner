# Enable exFAT support in FATFS so SD_MMC can mount exFAT-formatted cards
CONFIG_FATFS_EXFAT_SUPPORT=y

# NimBLE initialization triggers inter-core IPC calls that overflow the
# default ipc0 task stack (1024 bytes) on ESP32-S3.
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048

# mbedTLS memory: free handshake data as soon as it is no longer needed so the
# peak heap usage during HTTPS (OpenFoodFacts) stays below the available
# internal SRAM.  Without these flags the SSL client holds ~50 KB simultaneously,
# causing MBEDTLS_ERR_SSL_ALLOC_FAILED when WiFi + BLE + LVGL are all active.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# Disable hardware AES acceleration. The ESP32-S3 hardware AES engine requires
# DMA-capable internal SRAM for its working buffers, which is exhausted when
# BLE + WiFi are both active, causing "esp-aes: Failed to allocate memory"
# during HTTPS OTA downloads. Software AES uses the mbedtls platform allocator
# which is already redirected to PSRAM for OTA tasks (_ota_ssl_use_psram).
CONFIG_MBEDTLS_HARDWARE_AES=n
